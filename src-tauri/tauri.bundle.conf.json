{
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov", "m4v", "webm", "avi", "flv", "ts"],
        "name": "Video File",
        "description": "HongGuo Video",
        "role": "Viewer"
      }
    ],
    "resources": {
      "resources/libmpv-2.dll": "libmpv-2.dll",
      "resources/vulkan-1.dll": "vulkan-1.dll",
      "../LICENSE": "legal/LICENSE-GPL-3.0.txt",
      "legal/THIRD-PARTY-NOTICES.txt": "legal/THIRD-PARTY-NOTICES.txt",
      "legal/VULKAN-LOADER-LICENSE.txt": "legal/VULKAN-LOADER-LICENSE.txt",
      "legal/VULKAN-HEADERS-LICENSE.md": "legal/VULKAN-HEADERS-LICENSE.md",
      "legal/MPV-LGPL-2.1.txt": "legal/MPV-LGPL-2.1.txt",
      "legal/FFMPEG-LGPL-3.0.txt": "legal/FFMPEG-LGPL-3.0.txt",
      "legal/MPV-COPYRIGHT-REFERENCE.txt": "legal/MPV-COPYRIGHT-REFERENCE.txt",
      "legal/FFMPEG-LICENSE-REFERENCE.md": "legal/FFMPEG-LICENSE-REFERENCE.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
