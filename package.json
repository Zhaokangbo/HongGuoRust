{
  "name": "hongguorust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:discovery": "node --experimental-strip-types --test tests/discovery.test.mjs",
    "test:episode-queue": "node --experimental-strip-types --test tests/episode-queue.test.mjs",
    "test:provider-progress": "node --experimental-strip-types --test tests/provider-progress.test.mjs",
    "build": "npm run typecheck && npm run test:discovery && npm run test:episode-queue && npm run test:provider-progress && vite build",
    "tauri": "cargo tauri"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
