{
  "name": "hongguorust",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:discovery": "node --experimental-strip-types --test tests/discovery.test.mjs",
    "test:episode-queue": "node --experimental-strip-types --test tests/episode-queue.test.mjs",
    "test:provider-progress": "node --experimental-strip-types --test tests/provider-progress.test.mjs",
    "test:recent-activity": "node --experimental-strip-types --test tests/recent-activity.test.mjs",
    "test:local-library": "node --experimental-strip-types --test tests/local-library.test.mjs",
    "test:player-shortcuts": "node --experimental-strip-types --test tests/player-shortcuts.test.mjs",
    "test:thumbnail-preview": "node --experimental-strip-types --test tests/thumbnail-preview.test.mjs",
    "test:media-tracks": "node --experimental-strip-types --test tests/media-tracks.test.mjs",
    "test:player-preferences": "node --experimental-strip-types --test tests/player-preferences.test.mjs",
    "test:runtime-health": "node --experimental-strip-types --test tests/runtime-health.test.mjs",
    "test:m12b-trend": "node --test tests/m12b-trend.test.mjs",
    "test:m12c-fault-fixtures": "node --test tests/m12c-fault-fixtures.test.mjs",
    "test:hg2a-community": "node --test tests/hg2a-community-gateway.test.mjs",
    "test:hg2b-covers": "node --experimental-strip-types --test tests/hg2b-cover.test.mjs",
    "build": "npm run typecheck && npm run test:discovery && npm run test:overlay-context && npm run test:episode-queue && npm run test:provider-progress && npm run test:recent-activity && npm run test:local-library && npm run test:detail-episodes && npm run test:player-volume && npm run test:player-shortcuts && npm run test:thumbnail-preview && npm run test:media-tracks && npm run test:player-preferences && npm run test:runtime-health && npm run test:m12b-trend && npm run test:m12c-fault-fixtures && npm run test:hg2a-community && npm run test:hg2b-covers && vite build",
    "tauri": "cargo tauri",
    "test:overlay-context": "node --experimental-strip-types --test tests/overlay-context.test.mjs",
    "test:detail-episodes": "node --experimental-strip-types --test tests/detail-episodes.test.mjs",
    "test:player-volume": "node --experimental-strip-types --test tests/player-volume.test.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
